# Copy to .dev.vars for LOCAL development only. Never commit .dev.vars.
# In Cloudflare use Settings > Variables and Secrets instead (see README.md).

# "development" lets the form work on localhost without Turnstile keys. NEVER set it in Cloudflare.
ENVIRONMENT=development

# Long random strings, for example the output of:  openssl rand -base64 48
APP_SECRET=replace-with-a-long-random-string
ADMIN_SETUP_TOKEN=replace-with-a-different-long-random-string

# Cloudflare Turnstile. Both keys MUST come from the same Turnstile widget.
# Leave empty locally, or use Cloudflare's published test keys: https://developers.cloudflare.com/turnstile/troubleshooting/testing/
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Used only by the automated tests (npm test). Any value of 12 or more characters.
TEST_ADMIN_PASSWORD=
