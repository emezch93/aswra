{
  "name": "aswra-mvp",
  "version": "1.0.0",
  "private": true,
  "description": "ASWRA website and membership management system (Cloudflare Pages, Functions and D1)",
  "scripts": {
    "layout": "node scripts/sync-layout.js",
    "db:migrate:local": "wrangler d1 migrations apply aswra-membership --local",
    "db:migrate:remote": "wrangler d1 migrations apply aswra-membership --remote",
    "dev": "wrangler pages dev . --d1=DB --port 8788",
    "setup:admin": "node scripts/secure-admin-setup.js",
    "test": "node tests/e2e.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.24.2",
    "jsdom": "^25.0.1",
    "wrangler": "^4.164.0"
  }
}
